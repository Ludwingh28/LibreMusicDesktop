{
  "name": "libremusic",
  "version": "1.2.0",
  "description": "LibreMusic: YouTube Music de escritorio sin anuncios, con Electron",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "Ludwing Herrera Justiniano",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.ludwing.ytmdesktop",
    "productName": "LibreMusic",
    "files": [
      "main.js",
      "preload.js",
      "import-session.html",
      "import-session-preload.js",
      "about.html",
      "about-preload.js",
      "assets/**/*"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Ludwingh28",
      "repo": "LibreMusicDesktop"
    },
    "nsis": {
      "shortcutName": "LibreMusic",
      "uninstallDisplayName": "LibreMusic"
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "cross-fetch": "4.1.0",
    "electron-updater": "6.8.9",
    "electron-window-state": "5.0.3"
  }
}
